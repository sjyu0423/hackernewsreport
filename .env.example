# QwenNews M0 configuration (copy to .env and adjust as needed)

# SQLite database path (relative to cwd or absolute)
QWENNEWS_DB_PATH=data/qwennews.db

# HTTP User-Agent sent to public feeds and article pages
QWENNEWS_USER_AGENT=QwenNews/0.1 (+https://localhost; local news aggregator; research use)

# Request timeouts (seconds)
QWENNEWS_CONNECT_TIMEOUT=5
QWENNEWS_READ_TIMEOUT=20

# Maximum response body size for article pages (bytes)
QWENNEWS_MAX_RESPONSE_BYTES=2097152

# Per-source item fetch limits during collect
QWENNEWS_HN_LIMIT=30
QWENNEWS_RSS_LIMIT=20

# Concurrent request limits
QWENNEWS_MAX_CONCURRENCY=4

# Comma-separated enabled sources:
# hackernews, openai, deepmind, huggingface, techcrunch
QWENNEWS_ENABLED_SOURCES=hackernews,openai,deepmind,huggingface,techcrunch

# Whether to attempt article body extraction (true/false)
QWENNEWS_EXTRACT_CONTENT=true

# Whether to respect robots.txt (true/false; default true)
QWENNEWS_RESPECT_ROBOTS=true

# --- M1: local Ollama / Qwen3 analysis ---
# Exact installed model id (discover with: curl localhost:11434/api/tags)
QWENNEWS_OLLAMA_BASE_URL=http://127.0.0.1:11434
QWENNEWS_OLLAMA_MODEL=qwen3:4b
QWENNEWS_OLLAMA_TIMEOUT=180
QWENNEWS_OLLAMA_NUM_PREDICT=900
# Default non-thinking for M1 initial runs
QWENNEWS_OLLAMA_THINK=false
QWENNEWS_OLLAMA_TEMPERATURE=0.1
QWENNEWS_REPORT_DIR=data/reports

# M2: optional category priority overrides (name:score pairs)
# Example: weather:1.0,models:5.0,research:4.7
QWENNEWS_CATEGORY_PRIORITIES=
