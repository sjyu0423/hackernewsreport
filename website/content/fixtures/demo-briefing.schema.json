{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwennews.local/schemas/demo-briefing.schema.json",
  "title": "QwenNewsPublicDemoBriefing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "disclaimer",
    "generated_for",
    "snapshot_id",
    "recorded_at",
    "model_id",
    "items"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "static_demo_briefing" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "generated_for": { "type": "string", "const": "public-website" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_quantization": { "type": "string" },
    "selection_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "url_verification": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "headline",
          "summary",
          "why_it_matters",
          "source_url",
          "source_name",
          "category",
          "relevance_score",
          "significance_score",
          "evidence_sufficiency",
          "disclaimer"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^demo-[0-9]{2}$" },
          "headline": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "source_name": { "type": "string", "minLength": 1 },
          "published_at": { "type": ["string", "null"] },
          "category": { "type": "string", "minLength": 1 },
          "relevance_score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "significance_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "evidence_sufficiency": {
            "type": "string",
            "enum": ["sufficient", "partial", "insufficient"]
          },
          "limitations": { "type": ["string", "null"] },
          "key_claims": {
            "type": "array",
            "items": { "type": "string" }
          },
          "model_id": { "type": "string" },
          "disclaimer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
